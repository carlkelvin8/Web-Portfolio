{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build-static.mjs",
  "outputDirectory": "static-dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/freelance-web-developer-philippines",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/freelance-web-developer-philippines.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/web-developer-bulacan",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/web-developer-bulacan.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/mobile-app-developer-philippines",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/mobile-app-developer-philippines.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/admin-dashboard-developer",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/admin-dashboard-developer.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/mvp-development",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/mvp-development.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/public/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
